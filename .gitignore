# Keep ad-hoc historical cluster scripts local. Curated public scripts that
# are already tracked remain tracked; explicitly allow new release utilities.
scripts/*
!scripts/train-policy.sh
!scripts/evaluate-baseline.sh
!scripts/evaluate-policy.sh
!scripts/smoke-test.sh
!scripts/slurm-evaluate.sh

# Institution-specific HEC/Slurm orchestration is retained locally only.
